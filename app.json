{
  "expo": {
    "name": "Poko: Learn Anything",
    "slug": "poko",
    "scheme": "poko",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tylercyert.poko",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tylercyert.poko",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#6D28D9"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Poko: Learn Anything",
      "shortName": "Poko",
      "lang": "en",
      "description": "Learn anything, for a real reason. Poko turns your goal into a skill path of short interactive lessons.",
      "themeColor": "#6D28D9",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "orientation": "portrait",
      "barStyle": "default",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#6D28D9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
