{
  "name": "indy-learning-app",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.23",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm test",
    "export:all": "expo export --platform all"
  },
  "private": true,
  "engines": {
    "node": ">=24.3.0 <25"
  }
}
